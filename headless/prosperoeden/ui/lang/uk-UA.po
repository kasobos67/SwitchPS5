msgstr "Знайдено збереження Ryujinx"

#. The app can read only its own folder; {0} is a number.
#: pe/ui/browse.cpp
msgid "Sandboxed (code {0}): app folder only"
msgstr "Пісочниця (код {0}): лише папка програми"

#. A row of a game's settings: the game's saved progress, which can be copied in or out.
#: pe/ui/library.cpp
msgid "Save data"
msgstr "Збережені дані"

#. Short status at the right of the Save data row: a folder with a save to import.
#: pe/ui/library.cpp
msgid "Save folder found"
msgstr "Знайдено папку зі збереженням"

#: pe/ui/library.cpp
msgid "Saved for this game. Applies on next launch."
msgstr "Збережено для цієї гри. Діятиме з наступного запуску."

#: pe/ui/browse.cpp, pe/ui/launcher.cpp
msgid "Saved. Applies when a game starts."
msgstr "Збережено. Застосується під час запуску гри."

#: pe/ui/browse.cpp
msgid "Saved. Reopen ProsperoEden to use this folder."
msgstr "Збережено. Перезапустіть ProsperoEden, щоб використовувати цю папку."

#. Button hint: choose the highlighted item (not the Select button).
#: pe/ui/home.cpp, pe/ui/library.cpp, pe/ui/settings.cpp
msgid "Select"
msgstr "Вибрати"

#: pe/ui/library.cpp
msgid "Select a game"
msgstr "Виберіть гру"

#: pe/ui/library.cpp
msgid "Select a game to begin"
msgstr "Виберіть гру, щоб почати"

#: pe/ui/library.cpp
msgid "Select a readable game to configure its mode."
msgstr "Щоб налаштувати режим, виберіть гру, яка читається."

#. Select is a button's name (unchanged).
#: pe/ui/settings.cpp
msgid "Select is the touchpad button on PS5."
msgstr "Select на PS5 — кнопка сенсорної панелі."

#. Heading: the language highlighted in the list.
#: pe/ui/browse.cpp
msgid "SELECTED"
msgstr "ВИДІЛЕНО"

