msgstr "Вибраний ROM більше недоступний"

#: pe/ui/home.cpp, pe/ui/settings.cpp
msgid "Settings"
msgstr "Налаштування"

#. Label: whether keys and firmware are in place.
#: pe/ui/settings.cpp
msgid "SETUP"
msgstr "НАЛАШТУВАННЯ"

#: eden_services.cpp, host/fake_services.cpp
msgid "Setup required"
msgstr "Потрібне налаштування"

#: eden_services.cpp, host/fake_services.cpp
msgid "Setup required: {0} Open Settings, Game files to choose the folder that holds your keys, firmware and roms folders (or add the files to {1}), then reopen ProsperoEden."
msgstr "Потрібне налаштування: {0} Відкрийте «Налаштування» > «Файли ігор» і виберіть папку, де лежать папки keys, firmware і roms (або додайте файли до {1}), а потім перезапустіть ProsperoEden."

#: pe/ui/settings.cpp
msgid "Setup status and detailed logs."
