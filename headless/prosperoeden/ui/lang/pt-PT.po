msgid "This game has no save to export yet."
msgstr "Este jogo ainda não tem nenhuma gravação para exportar."

#: pe/ui/library.cpp
msgid "This game's settings cannot be saved (no title ID)."
msgstr "Não é possível guardar as definições deste jogo (sem ID de título)."

#. ryujinx/, save-import/ and roms/ are folder names (unchanged); {0} is the game's ID.
#: eden_services.cpp
msgid "To import, copy a Ryujinx folder to ryujinx/ or a save to save-import/{0}/, next to roms/."
msgstr "Para importar, copia uma pasta do Ryujinx para ryujinx/ ou uma gravação para save-import/{0}/, ao lado de roms/."

