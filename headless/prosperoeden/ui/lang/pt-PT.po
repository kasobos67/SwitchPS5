#. Heading of the acknowledgements.
#: pe/ui/browse.cpp
msgid "THANKS"
msgstr "AGRADECIMENTOS"

#: pe/ui/browse.cpp
msgid "Thanks to the whole PS5 homebrew community and to every developer whose drivers, tools and libraries make ProsperoEden possible."
msgstr "Obrigado a toda a comunidade homebrew da PS5 e a todos os programadores cujos drivers, ferramentas e bibliotecas tornam o ProsperoEden possível."

#: pe/ui/settings.cpp
msgid "The folder that holds your keys, firmware and games."
msgstr "A pasta com as tuas chaves, o firmware e os jogos."

#. Why a game stopped. 'Settings, Video' is the menu path; 'the game's own settings' is the Game settings dialog of the Library.
#: eden_services.cpp
msgid "The game ran out of graphics memory. Lower the resolution in Settings, Video (or in the game's own settings) and start it again."
msgstr "O jogo ficou sem memória gráfica. Reduz a resolução em Definições, Vídeo (ou nas definições do próprio jogo) e volta a iniciá-lo."

#: pe/ui/settings.cpp
msgid "The language games use when they offer it."
msgstr "O idioma usado pelos jogos, quando disponível."

#: pe/ui/browse.cpp
