#: pe/ui/home.cpp, pe/ui/settings.cpp
msgid "Settings"
msgstr "Definições"

#. Label: whether keys and firmware are in place.
#: pe/ui/settings.cpp
msgid "SETUP"
msgstr "CONFIGURAÇÃO"

#: eden_services.cpp, host/fake_services.cpp
msgid "Setup required"
msgstr "Configuração necessária"

#: eden_services.cpp, host/fake_services.cpp
msgid "Setup required: {0} Open Settings, Game files to choose the folder that holds your keys, firmware and roms folders (or add the files to {1}), then reopen ProsperoEden."
msgstr "Configuração necessária: {0} Acede a Definições, Ficheiros de jogo para escolheres a pasta que contém as pastas keys, firmware e roms (ou adiciona os ficheiros a {1}) e, em seguida, reabre o ProsperoEden."

#: pe/ui/settings.cpp
msgid "Setup status and detailed logs."
msgstr "Estado da configuração e registos detalhados."

#: eden_services.cpp
msgid "Setup validation failed. Check that firmware and key files are readable and valid."
msgstr "A validação da configuração falhou. Verifica se os ficheiros de firmware e de chaves são legíveis e válidos."

#: pe/ui/settings.cpp
msgid "Shortcuts during a game, and vibration."
msgstr "Atalhos durante o jogo e vibração."

#: pe/ui/settings.cpp
msgid "Show or hide the FPS overlay"
msgstr "Mostra ou oculta o contador de FPS"

#: pe/ui/library.cpp
msgid "SIZE"
msgstr "TAMANHO"

#: pe/ui/settings.cpp
msgid "Solid panels, brighter text and an outlined highlight."
msgstr "Painéis opacos, texto mais claro e realce com contorno."

