#: settings_store.h
msgid "Spanish (Latin America)"
msgstr "Espanhol (América Latina)"

#. The app creates its user the first time a game runs.
#: eden_services.cpp
msgid "Start any game once before importing a save."
msgstr "Inicia um jogo qualquer uma vez antes de importares uma gravação."

#. Shown over a game's cover while it starts.
#: pe/ui/launcher.cpp
msgid "STARTING"
msgstr "A INICIAR"

#: pe/ui/settings.cpp
msgid "Stops the background drifting and the screens sliding, here and on the loading screen."
msgstr "Impede o fundo de se mover e os ecrãs de deslizar, aqui e no ecrã de carregamento."

