<rml>
  <head>
    <title>ProsperoEden</title>
    <link type="text/rcss" href="styles/app.rcss" />
  </head>
  <body>
    <div id="app-shell">
      <img id="background" src="background-menu.tga" width="2048" height="1152" alt=""/>
      <div id="shade"></div>

      <header id="header">
        <img id="brand-icon" src="icons/brand-72.tga" width="72" height="72" alt=""/>
        <span id="brand-name">PROSPEROEDEN</span>
        <span id="brand-version">PS5 EDITION  /  v1.000.040</span>
        <span id="menu-clock">--:--</span>
      </header>
      <nav id="menu">
        <button id="load-rom" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Library</span></button>
        <button id="settings" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>Settings</span></button>
        <button id="help-about" class="nav-item"><img class="nav-focus" src="chrome/nav-focused.tga" width="136" height="64" alt=""/><span>About</span></button>
      </nav>

      <main id="last-played-card">
        <img class="hero-chrome" src="chrome/hero-panel.tga" width="1680" height="480" alt=""/>
        <img id="last-played-cover" src="icons/prosperoeden.tga" width="336" height="336" alt=""/>
        <span class="hero-kicker">CONTINUE PLAYING</span>
        <span id="last-played-title">Your next adventure</span>
        <span id="last-played-caption">Choose a game from your library.</span>
        <button id="continue-game" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span id="continue-copy">Resume game</span></button>
        <button id="hero-options" class="hero-button"><img class="hero-button-chrome base-chrome" src="chrome/hero-button.tga" width="272" height="72" alt=""/><img class="hero-button-chrome focused-chrome" src="chrome/hero-button-focused.tga" width="272" height="72" alt=""/><span>Game details</span></button>
        <span class="hero-footnote">Eden emulator for PlayStation 5</span>
      </main>

      <section id="recent-section">
        <span class="section-label">RECENTLY PLAYED</span>
        <button id="view-all"><img class="view-all-focus" src="chrome/view-all-focused.tga" width="304" height="40" alt=""/><span>VIEW ALL GAMES</span></button>
        <span id="recent-empty">Games you launch will appear here.</span>
        <button id="recent-0" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-0" class="recent-cover" src="icons/prosperoeden.tga" width="96" height="96" alt=""/><span id="recent-title-0" class="recent-title"></span></button>
        <button id="recent-1" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-1" class="recent-cover" src="icons/prosperoeden.tga" width="96" height="96" alt=""/><span id="recent-title-1" class="recent-title"></span></button>
        <button id="recent-2" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-2" class="recent-cover" src="icons/prosperoeden.tga" width="96" height="96" alt=""/><span id="recent-title-2" class="recent-title"></span></button>
        <button id="recent-3" class="recent-tile"><img class="recent-chrome base-chrome" src="chrome/recent-tile.tga" width="400" height="144" alt=""/><img class="recent-chrome focused-chrome" src="chrome/recent-tile-focused.tga" width="400" height="144" alt=""/><img id="recent-cover-3" class="recent-cover" src="icons/prosperoeden.tga" width="96" height="96" alt=""/><span id="recent-title-3" class="recent-title"></span></button>
      </section>

      <div id="startup-status"></div>
      <footer id="footer">
        <span class="controller-hint hint-select"><img src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Select</span></span>
        <span class="controller-hint hint-options"><img src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Details</span></span>
        <span class="controller-hint hint-nav"><img src="icons/dpad-mono.tga" width="26" height="26" alt=""/><span>Navigate</span></span>
        <span id="system-status">Checking library and firmware</span>
      </footer>

      <div id="rom-dialog" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Your games</span>
        <span class="library-copy">Select a game to begin</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">LIBRARY</span>
          <div id="rom-list-viewport"><div id="rom-list-track">
            <span id="rom-row-0" class="library-row library-row-0 focused"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-0" class="library-row-name"></span><span id="rom-format-0" class="library-row-meta"></span></span>
            <span id="rom-row-1" class="library-row library-row-1"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-1" class="library-row-name"></span><span id="rom-format-1" class="library-row-meta"></span></span>
            <span id="rom-row-2" class="library-row library-row-2"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-2" class="library-row-name"></span><span id="rom-format-2" class="library-row-meta"></span></span>
            <span id="rom-row-3" class="library-row library-row-3"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-3" class="library-row-name"></span><span id="rom-format-3" class="library-row-meta"></span></span>
            <span id="rom-row-4" class="library-row library-row-4"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-4" class="library-row-name"></span><span id="rom-format-4" class="library-row-meta"></span></span>
            <span id="rom-row-5" class="library-row library-row-5"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-5" class="library-row-name"></span><span id="rom-format-5" class="library-row-meta"></span></span>
            <span id="rom-row-6" class="library-row library-row-6"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><span id="rom-name-6" class="library-row-name"></span><span id="rom-format-6" class="library-row-meta"></span></span>
          </div></div>
          <span id="library-empty">No ROM files found.</span>
          <span id="rom-scrollbar"><img class="scrollbar-track" src="chrome/scrollbar-track.tga" width="10" height="606" alt=""/><img id="rom-scrollbar-thumb" src="chrome/scrollbar-thumb.tga" width="10" height="110" alt=""/></span>
          <span id="library-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GAME DETAILS</span>
          <span id="game-detail-title">No ROM selected</span>
          <img id="game-cover" src="icons/prosperoeden.tga" width="288" height="288" alt=""/><span id="cover-caption"></span>
          <span class="game-detail-label game-detail-line-0">FORMAT</span><span id="game-detail-format" class="game-detail-value game-detail-line-0">-</span>
          <span class="game-detail-label game-detail-line-1">SIZE</span><span id="game-detail-size" class="game-detail-value game-detail-line-1">-</span>
          <span class="game-detail-label game-detail-line-2">ADD-ONS</span><span id="game-detail-addons" class="game-detail-value game-detail-line-2">-</span>
          <span class="game-path-label">FILE</span><span id="game-detail-path" class="game-path">-</span>
          <span id="game-mode-setting"><img src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><span class="game-mode-label">Console mode</span><span id="game-mode-value"><span id="mode-docked" class="mode-option"><img src="icons/mode-docked.tga" width="48" height="32" alt=""/><span>Docked</span></span><span id="mode-handheld" class="mode-option"><img src="icons/mode-handheld.tga" width="48" height="32" alt=""/><span>Handheld</span></span><span id="mode-unavailable">Unavailable</span></span></span>
          <span id="game-mode-hint"><img src="icons/leftright-mono.tga" width="26" height="26" alt=""/><span id="game-mode-hint-text">Change mode. Saved per game.</span></span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Select</span></span><span class="controller-hint lib-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint lib-hint-browse"><img class="hint-icon-0" src="icons/updown-mono.tga" width="26" height="26" alt=""/><span>Browse games</span></span><span class="controller-hint lib-hint-mode"><img class="hint-icon-0" src="icons/leftright-mono.tga" width="26" height="26" alt=""/><span>Console mode</span></span><span class="controller-hint lib-hint-options"><img class="hint-icon-0" src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Game settings</span></span></footer>
      </div>
      <div id="settings-dialog" class="settings-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Settings</span><span class="library-copy">Fine-tune your experience</span>
        <section class="settings-list-panel">
        <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
        <span class="library-panel-kicker">PREFERENCES</span>
        <span id="settings-row-0" class="dialog-row dialog-row-0 focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Video</span></span>
        <span id="settings-row-1" class="dialog-row dialog-row-1"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Audio</span></span>
        <span id="settings-row-2" class="dialog-row dialog-row-2"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Controls</span></span>
        <span id="settings-row-3" class="dialog-row dialog-row-3"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="diagnostics-label">Diagnostics</span></span>
        <span id="settings-row-4" class="dialog-row dialog-row-4"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span>Game files</span></span>
        </section>
        <aside class="settings-detail-panel"><img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">ON THIS CONSOLE</span>
          <span class="settings-detail-title">Make it yours.</span>
          <span class="settings-detail-copy">Adjust the essentials without leaving your library behind.</span>
          <span class="settings-detail-label settings-detail-one">VIDEO</span><span class="settings-detail-value settings-detail-one">Graphics backend and frame display</span>
          <span class="settings-detail-label settings-detail-two">AUDIO</span><span class="settings-detail-value settings-detail-two">Volume and mute</span>
          <span class="settings-detail-label settings-detail-three">CONTROLS</span><span class="settings-detail-value settings-detail-three">Shortcuts and vibration support</span>
          <span class="settings-detail-label settings-detail-four">DIAGNOSTICS</span><span class="settings-detail-value settings-detail-four">Setup status and detailed logs</span>
          <span class="settings-detail-label settings-detail-five">GAME FILES</span><span class="settings-detail-value settings-detail-five">Folder for keys, firmware and games</span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Select</span></span><span class="controller-hint lib-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint lib-hint-browse"><img class="hint-icon-0" src="icons/updown-mono.tga" width="26" height="26" alt=""/><span>Browse settings</span></span></footer>
      </div>
      <div id="files-dialog" class="library-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">Game files</span>
        <span class="library-copy">Choose the folder that holds your keys, firmware and games</span>
        <section class="library-list-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="library-panel-kicker">FOLDERS</span>
          <span id="files-path"></span>
          <div id="files-list-viewport">
            <span id="files-row-0" class="library-row library-row-0 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-0" class="library-row-name files-row-name"></span><span id="files-meta-0" class="library-row-meta files-row-meta"></span></span>
            <span id="files-row-1" class="library-row library-row-1 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-1" class="library-row-name files-row-name"></span><span id="files-meta-1" class="library-row-meta files-row-meta"></span></span>
            <span id="files-row-2" class="library-row library-row-2 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-2" class="library-row-name files-row-name"></span><span id="files-meta-2" class="library-row-meta files-row-meta"></span></span>
            <span id="files-row-3" class="library-row library-row-3 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-3" class="library-row-name files-row-name"></span><span id="files-meta-3" class="library-row-meta files-row-meta"></span></span>
            <span id="files-row-4" class="library-row library-row-4 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-4" class="library-row-name files-row-name"></span><span id="files-meta-4" class="library-row-meta files-row-meta"></span></span>
            <span id="files-row-5" class="library-row library-row-5 files-row"><img class="library-row-chrome base-chrome" src="chrome/library-row-normal.tga" width="760" height="78" alt=""/><img class="library-row-chrome focused-chrome" src="chrome/library-row-focused.tga" width="760" height="78" alt=""/><img class="files-icon files-icon-folder" src="icons/folder.tga" width="40" height="32" alt=""/><img class="files-icon files-icon-up" src="icons/folder-up.tga" width="40" height="32" alt=""/><span id="files-name-5" class="library-row-name files-row-name"></span><span id="files-meta-5" class="library-row-meta files-row-meta"></span></span>
          </div>
          <span id="files-empty">No folders here.</span>
          <span id="files-scrollbar"><img class="files-scrollbar-track" src="chrome/scrollbar-track.tga" width="10" height="518" alt=""/><img id="files-scrollbar-thumb" src="chrome/scrollbar-thumb.tga" width="10" height="110" alt=""/></span>
          <span id="files-position">0 OF 0</span>
        </section>
        <aside class="game-detail-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">THIS FOLDER</span>
          <span id="files-current"></span>
          <span class="files-label files-line-0">KEYS</span><span id="files-keys" class="files-value files-line-0"></span>
          <span class="files-label files-line-1">FIRMWARE</span><span id="files-firmware" class="files-value files-line-1"></span>
          <span class="files-label files-line-2">GAMES</span><span id="files-games" class="files-value files-line-2"></span>
          <span class="about-divider files-divider-0"></span>
          <span class="files-label files-line-3">IN USE</span><span id="files-in-use" class="files-value files-line-3"></span>
          <span class="files-label files-line-4">ACCESS</span><span id="files-access" class="files-value files-line-4"></span>
          <span class="about-divider files-divider-1"></span>
          <span id="files-message"></span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint files-hint-open"><img class="hint-icon-0" src="icons/cross-mono.tga" width="26" height="26" alt=""/><span>Open</span></span><span class="controller-hint files-hint-back"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span><span class="controller-hint files-hint-use"><img class="hint-icon-0" src="icons/triangle-mono.tga" width="26" height="26" alt=""/><span>Use this folder</span></span><span class="controller-hint files-hint-default"><img class="hint-icon-0" src="icons/square-mono.tga" width="26" height="26" alt=""/><span>Default folder</span></span><span class="controller-hint files-hint-browse"><img class="hint-icon-0" src="icons/dpad-mono.tga" width="26" height="26" alt=""/><span>Browse</span></span><span class="controller-hint files-hint-page files-hint-pair"><img class="hint-icon-0" src="icons/l1-mono.tga" width="26" height="26" alt=""/><img class="hint-icon-1" src="icons/r1-mono.tga" width="26" height="26" alt=""/><span>Page</span></span></footer>
      </div>
      <div id="video-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Video</span>
        <span class="dialog-copy">Graphics backend</span>
        <img id="video-backend-chrome" class="video-backend-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><select id="video-backend"><option value="opengl">OpenGL</option><option value="vulkan" selected="selected">Vulkan (recommended)</option></select><span class="video-backend-arrow"></span>
        <span id="resolution-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="resolution-label">Resolution: 1x (native)</span></span>
        <span id="filter-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="filter-label">Upscaling filter: Bilinear</span></span>
        <span id="hud-setting" class="dialog-row dialog-row-0 "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="hud-label">FPS overlay: On</span></span><span id="video-hint" class="dialog-hint">UP / DOWN Select / X Change / O Back</span>
      </div></div>
<div id="game-settings-dialog" class="dialog"><div class="dialog-panel">
        <img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/>
        <span class="dialog-title">Game settings</span>
        <span id="game-settings-name" class="dialog-copy"></span>
        <span id="gs-mode-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="gs-mode-label">Console mode: Docked</span></span>
        <span id="gs-renderer-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="gs-renderer-label">Renderer: Default</span></span>
        <span id="gs-resolution-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="gs-resolution-label">Resolution: Default</span></span>
        <span id="gs-filter-setting" class="dialog-row "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="gs-filter-label">Upscaling filter: Default</span></span>
        <span id="game-settings-hint" class="dialog-hint">UP / DOWN Select / LEFT / RIGHT Change / O Back</span>
      </div></div>
<div id="audio-dialog" class="dialog"><div class="dialog-panel"><img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/><span class="dialog-title">Audio</span><span class="dialog-copy">Game audio; PS5 system-menu music is unchanged.</span><span id="volume-setting" class="dialog-row dialog-row-0 "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="volume-label">Game volume: 100%</span></span><span id="mute-setting" class="dialog-row dialog-row-1 "><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="mute-label">Mute: Off</span></span><span id="audio-hint" class="dialog-hint">UP / DOWN Select / LEFT / RIGHT Adjust / O Back</span></div></div>
<div id="controls-dialog" class="dialog"><div class="dialog-panel"><img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/><span class="dialog-title">Controls</span><span class="dialog-copy">Controller shortcuts and supported features.</span><div class="settings-details">Select + L1: End game and return to menu.<br/>Select + R1: Show or hide FPS overlay.<br/><br/>Select is the touchpad button on PS5.</div><span id="vibration-setting" class="dialog-row settings-low focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="vibration-label">Vibration: On</span></span><span id="controls-hint" class="dialog-hint">X Change / O Back</span></div></div>
<div id="diagnostics-dialog" class="dialog"><div class="dialog-panel"><img class="dialog-panel-chrome" src="chrome/modal-panel.tga" width="820" height="720" alt=""/><span class="dialog-title">Diagnostics</span><span class="dialog-copy">Detailed logs apply to the next game launch.</span><div id="setup-details" class="settings-details"></div><span id="logging-setting" class="dialog-row settings-low focused"><img class="dialog-row-chrome base-chrome" src="chrome/dialog-row-normal.tga" width="736" height="94" alt=""/><img class="dialog-row-chrome focused-chrome" src="chrome/dialog-row-focused.tga" width="736" height="94" alt=""/><span id="logging-label">Detailed logging: Off</span></span><span id="diagnostics-hint" class="dialog-hint">X Toggle logging / O Back</span></div></div>
      <div id="about-dialog" class="library-screen about-screen">
        <img class="library-background" src="background.tga" width="1920" height="1080" alt=""/>
        <span class="library-shade"></span>
        <span class="library-title">About ProsperoEden</span>
        <span class="library-copy">Credits and setup</span>
        <section class="about-credit-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">PROJECT CREDITS</span>
          <span class="about-lead about-eden-lead">Powered by Eden</span>
          <span class="about-body about-eden">All credit for the Eden emulator goes to its developers and contributors.</span>
          <span class="about-link about-eden-link">eden-emu.dev</span>
          <span class="about-divider about-divider-vulkan"></span>
          <span class="about-subhead about-vulkan-head">THANKS</span>
          <span class="about-body about-vulkan">Thanks to the whole PS5 homebrew community and to every developer whose drivers, tools and libraries make ProsperoEden possible.</span>
          <span class="about-divider about-divider-port"></span>
          <span class="about-subhead about-port-head">PS5 EDITION</span>
          <span class="about-body about-port">ProsperoEden is an unofficial PS5 port brought to you by BlackBearReloaded.</span>
        </section>
        <aside class="about-setup-panel">
          <img class="library-panel-chrome" src="chrome/dialog-panel.tga" width="820" height="720" alt=""/>
          <span class="detail-kicker">GETTING STARTED</span>
          <span class="about-lead">Supply your own files</span>
          <span class="about-setup-label about-keys">KEYS</span><span id="about-keys-path" class="about-setup-path about-keys">keys/prod.keys</span>
          <span class="about-setup-label about-firmware">FIRMWARE</span><span id="about-firmware-path" class="about-setup-path about-firmware">firmware/*.nca</span>
          <span class="about-setup-label about-games">GAMES</span><span id="about-games-path" class="about-setup-path about-games">roms/ (NSP or XCI)</span>
          <span class="about-setup-label about-updates">UPDATES, DLC</span><span id="about-updates-path" class="about-setup-path about-updates">updates/ (NSP or XCI)</span>
          <span class="about-divider about-setup-divider"></span>
          <span class="about-note">Use extracted firmware NCA files. Choose the folder in Settings, Game files; restart the app after changing it.</span>
        </aside>
        <footer class="library-footer icon-footer"><span class="controller-hint lib-hint-select"><img class="hint-icon-0" src="icons/circle-mono.tga" width="26" height="26" alt=""/><span>Back</span></span></footer>
      </div>
    </div>
  </body>
</rml>
