* { box-sizing: border-box; }
body, div, header, nav, main, section, aside, footer, span, button, img { display: block; }
body { width: 1920px; height: 1080px; margin: 0; overflow: hidden; background-color: #06090a; color: #f0f5f2; font-family: "Montserrat"; font-size: 24px; font-style: normal; font-weight: 500; line-height: 36px; }
button { margin: 0; padding: 0; border: 0px transparent; border-radius: 0px; background-color: transparent; color: #f0f5f2; font-family: "Montserrat"; text-align: left; nav: auto; }
#app-shell { position: relative; width: 1920px; height: 1080px; overflow: hidden; background-color: #06090a; }
#background { position: absolute; left: -64px; top: -36px; width: 2048px; height: 1152px; }
#shade { display: none; }
.library-hidden { display: none; }
.focused-chrome { display: none; }
.hero-button.focused > .base-chrome, .recent-tile.focused > .base-chrome, .library-row.focused > .base-chrome, .dialog-row.focused > .base-chrome { display: none; }
.hero-button.focused > .focused-chrome, .recent-tile.focused > .focused-chrome, .library-row.focused > .focused-chrome, .dialog-row.focused > .focused-chrome { display: block; }

#header { position: absolute; left: 120px; top: 72px; width: 1680px; height: 88px; border-bottom: 1px rgba(240,245,242,0.12); }
#brand-icon { position: absolute; left: 0px; top: 0px; width: 72px; height: 72px; }
